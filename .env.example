# Local runtime. Keep real values in a private .env or the managed secret store.
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://operant:change-me@127.0.0.1:3306/operant_dev

# Manus OAuth/session/runtime values. Use the values for this project from the secure configuration.
MANUS_PROJECT_ID=your-project-id
MANUS_JWT_SECRET=replace-with-a-dedicated-random-session-signing-secret
MANUS_OAUTH_API_URL=https://api.manus.ai
MANUS_API_URL=https://api.manus.ai
MANUS_API_KEY=replace-with-server-side-manus-api-key
# Optional legacy owner hint; workspace roles remain application data.
OWNER_OPEN_ID=

# Generate a fresh 32-byte key encoded as base64 (for example: openssl rand -base64 32).
# Back up this value securely: rotating it makes previously encrypted provider credentials unreadable.
OPERANT_INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes

# Optional integration-test database; deliberately blank so tests are skipped by default.
# Set only to a separately provisioned disposable MySQL database with a standalone "test" segment.
# Never point this at DATABASE_URL, shared, staging, or production data.
OPERANT_TEST_DATABASE_URL=
